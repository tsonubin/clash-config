# Upstream subscription URL to fetch and rewrite. Keep this server-side only —
# do not put it in a client-visible query param, since it typically acts as a
# credential (e.g. a per-user path/token embedded in the URL).
SUBSCRIPTION_URL=https://your-subscription-host/your/path?format=clash

# Shared secret required as ?token=... on the /api/subscribe endpoint, so the
# deployed URL can't be scraped for your proxy/relay credentials by anyone who
# finds it. Generate one with: openssl rand -hex 24
SUBSCRIBE_TOKEN=

# Optional upstream SOCKS5 relay, used to give AI services a stable US egress.
# The AI group routes through it first (🛰 AI-ROUTE) and falls back to the
# normal nodes if it stops answering healthchecks. The relay is reached via
# dialer-proxy through your own nodes, not from the client's raw network.
#
# All three of HOST/USERNAME/PASSWORD must be set or the relay is omitted
# entirely. These end up in the served config in plaintext (as any client needs
# them), which is what SUBSCRIBE_TOKEN protects.
RELAY_HOST=
RELAY_PORT=443
RELAY_USERNAME=
RELAY_PASSWORD=

# Optional escape hatch: allow ?url=<encoded subscription URL> to override
# SUBSCRIPTION_URL at request time. Off by default — turning this on makes
# the endpoint fetch (and return) whatever URL a caller supplies, which is an
# SSRF-ish surface even behind SUBSCRIBE_TOKEN. Leave unset/0 unless you
# specifically need it (e.g. testing against multiple sources).
ALLOW_URL_OVERRIDE=0
